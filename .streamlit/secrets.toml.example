# ==============================================================================
# NecroTrace // Streamlit Secrets Configuration Template
# ==============================================================================
# For local development:
#   Copy this file to: .streamlit/secrets.toml
#
# For Streamlit Community Cloud:
#   Go to share.streamlit.io -> App Settings -> Secrets -> Paste the contents below.
#
# Obtain your Firebase Web API Key:
#   1. Visit https://console.firebase.google.com/
#   2. Open your Project -> Project Settings -> General tab.
#   3. Under "Your project", locate "Web API Key".
#   4. Under Authentication -> Sign-in method, ensure "Email/Password" is ENABLED.
# ==============================================================================

# Firebase Web API Key (required for real-time Firebase Auth)
FIREBASE_WEB_API_KEY = "AIzaSy..."

# Firebase Project ID (e.g., necrotrace-forensics)
FIREBASE_PROJECT_ID = "necrotrace-forensics"
